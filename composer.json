{
    "name": "glpi/approvalbymail",
    "description": "GLPI plugin — approval by mail (token-based, no login required)",
    "type": "glpi-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Approvalbymail\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        }
    },
    "scripts": {
        "cs-check": "php-cs-fixer fix --diff --dry-run",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --configuration=phpstan.neon",
        "test": "phpunit"
    }
}
